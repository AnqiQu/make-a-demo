{
  "$schema": "https://opencode.ai/config.json",
  "lsp": true,
  "permission": {
    "read": {
      "*": "allow",
      ".env": "deny",
      ".env.*": "deny",
      "*.env": "deny",
      "*.env.*": "deny",
      "**/.env": "deny",
      "**/.env.*": "deny",
      "**/*.env": "deny",
      "**/*.env.*": "deny"
    }
  },
  "skills": {
    "paths": [".agents/skills"]
  }
}

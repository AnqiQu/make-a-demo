{
  "name": "makeademo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "arch:deps": "depcruise src --config .dependency-cruiser.cjs --include-only \"^src\"",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "demo": "vite --host 127.0.0.1 --port 3000",
    "demo:capture-scenes": "bun src/server/pipeline/06-capture/cli.mts",
    "demo:composite-video": "bun src/server/pipeline/07-compositing/cli.mts",
    "demo:validate-scripts": "bun scripts/validate-demo-playwright-scripts.mts",
    "dev": "vite",
    "fmt": "biome format --write .",
    "graph:deps": "bun scripts/regenerate-dependency-graphs.mts",
    "knip": "knip",
    "lint": "biome check .",
    "lsp:typescript": "typescript-language-server --stdio",
    "preview": "vite preview",
    "stage1:run": "bun src/server/shared/pipeline-runner/stage1-cli.mts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@opencode-ai/sdk": "^1.16.2",
    "@remotion/bundler": "^4.0.473",
    "@remotion/renderer": "^4.0.473",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.473"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@playwright/test": "^1.60.0",
    "@types/node": "^22.15.3",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "bun-types": "^1.2.5",
    "dependency-cruiser": "^17.4.2",
    "knip": "^6.3.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "typescript-language-server": "^5.2.0",
    "vite": "^6.0.7",
    "vitest": "^3.1.1"
  }
}

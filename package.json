{
  "name": "makeademo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "makeademo": "./src/apps/cli/main.ts"
  },
  "scripts": {
    "agent": "bun run src/apps/cli/main.ts",
    "arch:deps": "depcruise src --config .dependency-cruiser.cjs --include-only \"^src\"",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "dev": "vite",
    "fmt": "biome format --write .",
    "graph:deps": "bun scripts/regenerate-dependency-graphs.mts",
    "knip": "knip",
    "lint": "biome check .",
    "lsp:typescript": "typescript-language-server --stdio",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^4.0.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^22.15.3",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "bun-types": "^1.2.5",
    "dependency-cruiser": "^17.4.2",
    "knip": "^6.3.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "typescript-language-server": "^5.2.0",
    "vite": "^6.0.7",
    "vitest": "^3.1.1"
  }
}

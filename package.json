{
  "name": "makeademo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.3.14",
  "type": "module",
  "scripts": {
    "arch:deps": "depcruise src --config .dependency-cruiser.cjs --include-only \"^src\"",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "demo": "vite demo --host 127.0.0.1 --port 3000",
    "demo:validate-scripts": "bun scripts/validate-demo-playwright-scripts.mts",
    "db:migrate": "drizzle-kit push",
    "dev": "concurrently -k \"bun run dev:api\" \"bun run dev:web\"",
    "dev:api": "bun --watch src/server/api/server.mts",
    "dev:web": "vite",
    "fmt": "biome format --write .",
    "graph:deps": "bun scripts/regenerate-dependency-graphs.mts",
    "knip": "knip",
    "knip:prod": "knip --production --include files --no-exit-code",
    "lint": "biome check .",
    "lsp:typescript": "typescript-language-server --stdio",
    "pipeline:matrix": "bun scripts/run-pipeline-matrix.ts",
    "pipeline:run": "bun scripts/run-demo-pipeline.mts",
    "preview": "vite preview",
    "start": "bun src/server/api/server.mts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "verify:daytona-image": "bun scripts/verify-daytona-image.mts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1063.0",
    "@aws-sdk/s3-request-presigner": "^3.1063.0",
    "@daytona/sdk": "0.193.0",
    "@remotion/bundler": "^4.0.473",
    "@remotion/renderer": "^4.0.473",
    "drizzle-orm": "^0.45.2",
    "jsonc-parser": "^3.3.1",
    "lucide-react": "^1.17.0",
    "pino": "^10.3.1",
    "postgres": "^3.4.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.473",
    "semver": "^7.8.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@railway/cli": "5.8.0",
    "@types/node": "^22.15.3",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/semver": "^7.8.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "bun-types": "1.3.14",
    "concurrently": "^10.0.3",
    "dependency-cruiser": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "knip": "^6.3.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "typescript-language-server": "^5.2.0",
    "vite": "^6.0.7",
    "vitest": "^3.1.1"
  }
}
